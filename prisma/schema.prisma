generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdmissionApplication {
  id                  String   @id @default(uuid())
  reference           String   @unique
  status              String   @default("DRAFT")
  academicYear        String
  entry               String
  studyType           String
  learnerFullName     String
  learnerDateOfBirth  String
  learnerPreviousSchool String?
  submittedAt         DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  guardianId          String
  guardian            AdmissionGuardian @relation(fields: [guardianId], references: [id])
  documents           AdmissionDocument[]
  assignments         AdmissionReviewerAssignment[]
  notes               AdmissionReviewNote[]
  auditEvents         AdmissionAuditEvent[]
  notifications       AdmissionNotification[]
  @@index([status])
  @@index([submittedAt])
}

model AdmissionGuardian {
  id             String @id @default(uuid())
  fullName       String
  phone          String
  secondaryPhone String?
  nidaNumber     String
  email          String?
  relationship   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  applications   AdmissionApplication[]
  @@index([phone])
  @@index([nidaNumber])
}

model AdmissionDocument {
  id            String   @id @default(uuid())
  applicationId String
  key           String
  label         String
  status        String   @default("MISSING")
  objectKey     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId, status])
}

model AdmissionReviewerAssignment {
  id            String   @id @default(uuid())
  applicationId String
  reviewerId    String
  assignedAt    DateTime @default(now())
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([reviewerId])
  @@index([applicationId])
}

model AdmissionReviewNote {
  id            String   @id @default(uuid())
  applicationId String
  authorId      String
  body          String
  createdAt     DateTime @default(now())
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId, createdAt])
}

model AdmissionAuditEvent {
  id            String   @id @default(uuid())
  applicationId String
  action        String
  actorId       String?
  fromStatus    String?
  toStatus      String?
  reason        String?
  createdAt     DateTime @default(now())
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId, createdAt])
}

model AdmissionNotification {
  id            String   @id @default(uuid())
  applicationId String
  channel       String
  event         String
  deliveryState String   @default("PENDING")
  createdAt     DateTime @default(now())
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([deliveryState, createdAt])
}
