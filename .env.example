# PostgreSQL / Supabase database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sammena"

# UUID of the Sammena school row in the `schools` table.
# Required for school-scoped portal and calendar data access.
SAMMENA_SCHOOL_ID="00000000-0000-0000-0000-000000000000"

# Environment-backed admin identity
# Supported roles: SUPER_ADMIN, SCHOOL_ADMIN, ADMIN, EDITOR, VIEWER, TEACHER, PARENT, STUDENT
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""
ADMIN_ROLE="SUPER_ADMIN"
# Stable audit actor identifier for this environment-backed administrator.
ADMIN_USER_ID="admin"
