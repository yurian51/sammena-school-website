# PostgreSQL / Supabase database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sammena"

# Supabase Auth (publishable/anon key is safe for Auth API requests; never put a service-role key in NEXT_PUBLIC_*).
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
# Legacy key names are supported for existing deployments:
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# First administrator bootstrap only, run locally and never commit these secrets.
# SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"
# ADMIN_EMAIL="admin@your-school-domain.example"
# ADMIN_PASSWORD="GENERATE_A_RANDOM_PASSWORD_OF_AT_LEAST_20_CHARACTERS"

# UUID of the Sammena school row in the schools table.
SAMMENA_SCHOOL_ID="4453b19d-62d7-44df-8502-2e69cfb905ed"
